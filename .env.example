# Lawgda Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (public – safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public – safe for client; limited permissions)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (SERVER ONLY – never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── KMS ─────────────────────────────────────────────────────────────────────
# Master secret used to derive AES-256-GCM keys via HKDF-SHA256.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
KMS_MASTER_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# ── Application ─────────────────────────────────────────────────────────────
# Public URL of this application (used in QR code verification links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
